{
  "name": "azean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A modern JavaScript/TypeScript danmaku game with focus on functional programming patterns and type safety.",
  "keywords": [
    "danmaku",
    "bullet hell",
    "bullet heaven",
    "shmup",
    "Touhou-like"
  ],
  "license": "BSD-3-Clause",
  "author": "Duncan Kolba <duncankolba@gmail.com>",
  "contributors": [
    {
      "name": "Duncan Kolba",
      "email": "duncankolba@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkolba/azean.git"
  },
  "scripts": {
    "build": "vite build",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ok": "node scripts/ok.js",
    "start": "npm run dev",
    "test": "pnpm run test:chromium && pnpm run test:firefox && pnpm run test:webkit",
    "test:chromium": "vitest run --browser=chromium --coverage ",
    "test:firefox": "vitest run --browser=firefox",
    "test:webkit": "vitest run --browser=webkit",
    "typecheck": "tsc --noEmit",
    "upgrade": "pnpm upgrade --latest",
    "upgrade:interactive": "pnpm upgrade --interactive --latest",
    "knip": "knip"
  },
  "dependencies": {
    "pixi.js": "8.20.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@pixi/devtools": "2.0.1",
    "@types/node": "26.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "knip": "6.32.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
