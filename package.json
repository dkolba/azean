{
  "name": "azean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A modern JavaScript/TypeScript danmaku game with focus on functional programming patterns and type safety.",
  "keywords": [
    "danmaku",
    "bullet hell",
    "bullet heaven",
    "shmup",
    "Touhou-like"
  ],
  "license": "BSD-3-Clause",
  "author": "Duncan Kolba <duncankolba@gmail.com>",
  "contributors": [
    {
      "name": "Duncan Kolba",
      "email": "duncankolba@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkolba/azean.git"
  },
  "scripts": {
    "build": "vite build",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ok": "node scripts/ok.js",
    "start": "npm run dev",
    "test": "pnpm run test:chromium && pnpm run test:firefox && pnpm run test:webkit",
    "test:chromium": "vitest run --browser=chromium --coverage ",
    "test:firefox": "vitest run --browser=firefox",
    "test:webkit": "vitest run --browser=webkit",
    "typecheck": "tsc --noEmit",
    "upgrade": "pnpm upgrade --latest",
    "upgrade:interactive": "pnpm upgrade --interactive --latest",
    "knip": "knip"
  },
  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@pixi/devtools": "2.0.1",
    "@types/node": "26.4.1",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-jsdoc": "64.3.6",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "knip": "6.34.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
